# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Primary LLM provider: groq | ollama
LLM_PROVIDER=groq

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (offline fallback) - requires `ollama serve` running locally
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Whisper
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8

# Storage
DB_PATH=data/db/meetings.db

# Extraction tuning
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=150
LOW_CONFIDENCE_THRESHOLD=0.80

# LLM output budget. On Groq free tier prompt + this must stay under
# the 8000 tokens-per-minute ceiling.
LLM_MAX_TOKENS=3000
LLM_RATE_LIMIT_RETRIES=3

# gpt-oss reasoning budget: low | medium | high. Empty disables the param.
GROQ_REASONING_EFFORT=low
